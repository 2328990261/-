@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle

title 推荐模块架构图（兼容版）
top to bottom direction

actor "普通用户" as U
actor "管理员" as A

package "前端展示层" {
  rectangle "首页/推荐页\n展示推荐列表" as FE_REC
  rectangle "行为上报入口\n阅读/收藏/评论/不感兴趣" as FE_BEH
  rectangle "推荐设置入口\n用户偏好设置与后台参数调整" as FE_CFG
  FE_REC -[hidden]right- FE_BEH
  FE_BEH -[hidden]right- FE_CFG
}

package "业务接入层" {
  rectangle "推荐请求处理" as C_REC
  rectangle "用户行为处理" as C_BEH
  rectangle "推荐参数处理" as C_CFG
  C_REC -[hidden]right- C_BEH
  C_BEH -[hidden]right- C_CFG
}

package "推荐引擎层" {
  rectangle "候选召回\n基于标签的内容匹配" as E1
  rectangle "融合打分\n协同信号与热度补偿" as E2
  rectangle "重排输出\n多样性、去重、条数控制" as E3
  E1 -[hidden]right- E2
  E2 -[hidden]right- E3
}

package "数据与配置层" {
  rectangle "内容数据\n小说标签、作者、阅读量" as D1
  rectangle "行为数据\n收藏、阅读历史、完读、评论、不感兴趣" as D2
  rectangle "配置数据\n推荐主参数、行为权重、用户画像、标签权重" as D3
  D1 -[hidden]right- D2
  D2 -[hidden]right- D3
}

U --> FE_REC
U --> FE_BEH
A --> FE_CFG

FE_REC --> C_REC
FE_BEH --> C_BEH
FE_CFG --> C_CFG

C_REC --> E1
E1 --> E2
E2 --> E3
E3 --> FE_REC : 推荐结果

C_BEH --> D2
C_CFG --> D3
E1 ..> D1
E2 ..> D2
E2 ..> D3

FE_REC -[hidden]down- C_REC
C_REC -[hidden]down- E1
E1 -[hidden]down- D1

@enduml
