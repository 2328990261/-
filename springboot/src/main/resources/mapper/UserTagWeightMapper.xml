<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wangrui.springboot.mapper.UserTagWeightMapper">

    <resultMap id="RowMap" type="com.wangrui.springboot.pojo.UserTagWeightOverride">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="tag_name" property="tagName"/>
        <result column="weight" property="weight"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByUserId" resultMap="RowMap">
        SELECT id, user_id, tag_name, weight, updated_at
        FROM user_tag_weight
        WHERE user_id = #{userId}
        ORDER BY tag_name ASC
    </select>

    <insert id="upsert" parameterType="com.wangrui.springboot.pojo.UserTagWeightOverride">
        INSERT INTO user_tag_weight (user_id, tag_name, weight)
        VALUES (#{userId}, #{tagName}, #{weight})
        ON DUPLICATE KEY UPDATE
            weight = VALUES(weight),
            updated_at = NOW()
    </insert>

    <delete id="deleteByUserId">
        DELETE FROM user_tag_weight WHERE user_id = #{userId}
    </delete>

</mapper>

