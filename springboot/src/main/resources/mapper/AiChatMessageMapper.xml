<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangrui.springboot.mapper.AiChatMessageMapper">

    <resultMap id="AiChatMessageResultMap" type="com.wangrui.springboot.pojo.AiChatMessage">
        <id property="id" column="id"/>
        <result property="sessionId" column="session_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="thinking" column="thinking"/>
        <result property="imageUrl" column="image_url"/>
        <result property="booksJson" column="books_json"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.wangrui.springboot.pojo.AiChatMessage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_chat_message (session_id, role, content, thinking, image_url, books_json, created_at)
        VALUES (#{sessionId}, #{role}, #{content}, #{thinking}, #{imageUrl}, #{booksJson}, NOW())
    </insert>

    <select id="selectBySessionId" resultMap="AiChatMessageResultMap">
        SELECT id, session_id, role, content, thinking, image_url, books_json, created_at
        FROM ai_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY id ASC
    </select>

    <!-- 删除会话时级联清理该会话下的全部消息 -->
    <delete id="deleteBySessionId">
        DELETE FROM ai_chat_message
        WHERE session_id = #{sessionId}
    </delete>
</mapper>