{
  "name": "qingxiaoshuo",
  "version": "1.0.0",
  "private": true,
  "description": "轻小说推荐系统桌面版",
  "author": "wr",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:dir": "vite build && electron-builder --win --dir",
    "format": "prettier --write --experimental-cli src/",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint": "oxlint . --fix",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.qingxiaoshuo.app",
    "productName": "轻小说推荐系统",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "轻小说推荐系统",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "~1.38.0",
    "eslint-plugin-vue": "~10.6.2",
    "globals": "^17.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.38.0",
    "prettier": "3.7.4",
    "progress-webpack-plugin": "^1.0.16",
    "vite": "^7.3.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-cli-plugin-electron-builder": "~2.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "ISC",
  "type": "module"
}
